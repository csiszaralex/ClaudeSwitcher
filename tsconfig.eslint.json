{
  // Type checking and typed linting of the root scripts: `eslint.config.mjs` and `scripts/` (see the
  // `verify:root` script).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["eslint.config.mjs", "scripts/*.mjs"]
}
