{
  "name": "claudeswitcher",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "check-types": "nx run-many -t check-types",
    "lint": "nx run-many -t lint",
    "knip": "knip",
    "verify:root": "tsc -p tsconfig.eslint.json && eslint eslint.config.mjs && knip",
    "verify": "nx run-many -t check-types lint test build && pnpm verify:root",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm verify"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "knip": "^6.43.0",
    "nx": "^21.0.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.0"
  }
}
