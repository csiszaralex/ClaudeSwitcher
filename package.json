{
  "name": "claudeswitcher",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "check-types": "nx run-many -t check-types",
    "lint": "nx run-many -t lint",
    "knip": "knip",
    "verify:root": "tsc -p tsconfig.eslint.json && eslint eslint.config.mjs && knip",
    "verify": "nx run-many -t check-types lint test build && pnpm verify:root",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm verify"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "knip": "^6.44.0",
    "nx": "^24.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
