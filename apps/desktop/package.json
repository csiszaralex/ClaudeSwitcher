{
  "name": "@claudeswitcher/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "check-types": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.web.test.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src electron.vite.config.ts vitest.config.ts",
    "predev": "install-electron",
    "prestart": "install-electron",
    "predist": "install-electron"
  },
  "dependencies": {
    "@claudeswitcher/core": "workspace:*",
    "@claudeswitcher/daemon": "workspace:*",
    "electron-updater": "6.8.11",
    "koffi": "^3.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "description": "Tray app that lists Claude Code sessions and answers their permission prompts"
}
