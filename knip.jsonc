{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The spike is a throwaway experiment and .superpowers holds working notes: neither is product code.
  "ignore": ["spikes/**", ".superpowers/**"],
  // Our packages export only to each other, nothing outside imports them: an unused export of an
  // entry point is dead code too.
  "includeEntryExports": true,
  // Nx release loads `@nx/js` by name for the version step of the desktop app (`nx.json` `release`);
  // no file imports it.
  "ignoreDependencies": ["@nx/js"],
  // knip finds the core's two entry points (the main one and the IO-free `/browser`) and the
  // daemon's in their package.json (`exports`, `main`), and its own plugins find the electron-vite
  // main and preload entry points and the vitest configs; what is listed here, they do not find.
  "workspaces": {
    "apps/desktop": {
      // The renderer's entry point is the HTML, and `window-api.ts` is a global type declaration
      // that nothing imports: the tsconfig `include` brings it in.
      // The setup window is a second page with its own global declaration, the same way. Its script
      // and its preload are listed too: knip did not follow `setup.html` to `setup-main.tsx` or find the
      // second preload entry by itself (measured: both reported as unused files).
      // `scripts/make-icon.mjs` is a one-off generator run by hand (`node scripts/make-icon.mjs`).
      "entry": [
        "src/renderer/index.html",
        "src/renderer/window-api.ts",
        "src/renderer/setup.html",
        "src/renderer/setup-window-api.ts",
        "src/renderer/setup-main.tsx",
        "src/preload/setup.ts",
        "scripts/make-icon.mjs"
      ]
    }
  }
}
